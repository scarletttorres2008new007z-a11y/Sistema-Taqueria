# Copie este archivo como .env (en la misma carpeta que iniciar.bat) y complete los valores.
# El archivo .env NO se debe compartir ni subir a GitHub: contiene contraseñas.
# Escriba las rutas con barras normales (C:/Taqueria/uploads), no con \ , y no use comillas.

# ---- Base de datos PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/taqueria
DB_USER=taqueria
# Escriba aquí la contraseña que eligió al crear el usuario "taqueria" en PostgreSQL
DB_PASSWORD=

# ---- Servidor ----
PORT=8080
# Carpeta donde se guardan logotipo, fotos de productos y comprobantes de gastos
UPLOADS_DIR=./uploads
# Ponga true solo si el sistema se publica con HTTPS
COOKIE_SECURE=false
# false = no se puede vender un producto si faltan ingredientes en inventario
PERMITIR_VENTA_SIN_EXISTENCIAS=false

# ---- Datos de demostración (opcionales) ----
# Solo para probar el sistema. Se cargan si la base está vacía y CARGAR_DEMO=true.
# Todos quedan marcados como "(demo)". No los use para operar el negocio real.
CARGAR_DEMO=false
# Contraseña (mínimo 8 caracteres) para los usuarios admin.demo, cajero.demo, etc.
DEMO_PASSWORD=

# ---- Pruebas automáticas (ejecutar-pruebas) ----
# Base SEPARADA que las pruebas borran y vuelven a crear en cada ejecución. Nunca use la base real.
DB_TEST_URL=jdbc:postgresql://localhost:5432/taqueria_test
